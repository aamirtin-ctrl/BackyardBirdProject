# Anthropic (caption generation)
ANTHROPIC_API_KEY=sk-ant-...

# Stock video APIs (both free, wildlife/nature sources)
# Pexels:   https://www.pexels.com/api/new/
# Pixabay:  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Cloudflare R2 (video hosting)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ig-poster
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# Instagram Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Runtime
LOG_LEVEL=INFO
DRY_RUN=false
# Post style: "static_video" (carousel: graded still + video) or "reels"
POST_STYLE=static_video
